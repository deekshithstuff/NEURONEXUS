# Optional structured AI analysis. Leave blank to use deterministic local analysis.
PAPERPILOT_AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional Google Identity Services sign-in. Configure a Web OAuth client ID.
GOOGLE_CLIENT_ID=

# Optional external plagiarism comparison. When configured, a manuscript is sent to the
# provider only after the user explicitly consents in the UI. Credentials stay on the backend.
PAPERPILOT_PLAGIARISM_PROVIDER=
COPYLEAKS_EMAIL=
COPYLEAKS_API_KEY=
COPYLEAKS_BASE_URL=https://api.copyleaks.com
COPYLEAKS_LOGIN_URL=https://id.copyleaks.com

# Optional directory of additional, clearly identified comparison texts (.txt/.md/.json).
# The internal checker reports matches against these sources by name.
PAPERPILOT_PLAGIARISM_CORPUS_DIR=
PAPERPILOT_PLAGIARISM_CLASSIFIER_PATH=
PAPERPILOT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2